{
  "name": "polyspot",
  "version": "0.1.0",
  "private": true,
  "description": "Daily campus photo game for Cal Poly Pomona: guess where a photo was taken and which way the camera faced.",
  "keywords": [
    "game",
    "photo",
    "map",
    "leaflet",
    "campus",
    "cal-poly-pomona"
  ],
  "homepage": "https://github.com/Rassa1/PolySpot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rassa1/PolySpot.git"
  },
  "bugs": {
    "url": "https://github.com/Rassa1/PolySpot/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "local": "node server.js --local",
    "test": "node --test",
    "check": "node scripts/check-syntax.js",
    "build:sql": "node scripts/build-sql.js",
    "vendor": "node scripts/vendor.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0"
  }
}
